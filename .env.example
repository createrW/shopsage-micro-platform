# ShopSage local environment. scripts/dev-up.sh copies this to .env (gitignored) on first run;
# docker compose reads .env automatically.
#
# DEV-ONLY DEFAULTS: change every password below on any shared or reachable host.

# --- PostgreSQL (one instance, one database + role per service; ADR-0001) ---------------------
POSTGRES_USER=shopsage
POSTGRES_PASSWORD=shopsage
# Per-service role passwords. Read by configs/postgres/init/01-create-databases.sh ONLY when the
# postgres_data volume is first created; changing them later requires ./scripts/dev-down.sh -v.
USER_DB_PASSWORD=shopsage_user
INVENTORY_DB_PASSWORD=shopsage_inventory
ORDER_DB_PASSWORD=shopsage_order
PAYMENT_DB_PASSWORD=shopsage_payment

# --- Grafana (user: admin) ----------------------------------------------------------------------
# Applied only when the grafana_data volume is first created; to change it later run
# ./scripts/dev-down.sh -v (wipes data) or
# `docker compose exec grafana grafana cli admin reset-admin-password <new>`.
GRAFANA_ADMIN_PASSWORD=admin

# --- Networking ---------------------------------------------------------------------------------
# Interface every published port binds to. Set to 0.0.0.0 only on a trusted network:
# Docker-published ports bypass host firewalls (ufw, pf).
BIND_HOST=127.0.0.1
# Host name Kafka advertises on its host listener (:9092). Set to the VM's IP or DNS name when
# BIND_HOST=0.0.0.0 (clients follow the advertised listener).
KAFKA_ADVERTISED_HOST=localhost

# --- Prometheus scrape targets for the four services --------------------------------------------
# host   = services run on the host (./mvnw spring-boot:run), scraped via host.docker.internal
# docker = services run in compose (--profile app); dev-up.sh selects this with --with-apps or when
#          the app containers are already running ("host" here is treated as the default, not a choice;
#          run PROMETHEUS_TARGETS=host ./scripts/dev-up.sh to force host mode)
# Selects configs/prometheus/targets/<value>.json; one job, so no double counting.
PROMETHEUS_TARGETS=host

# --- Applications (--profile app) ---------------------------------------------------------------
# Container memory limit per service; the JVM sizes its heap from it (MaxRAMPercentage=60).
APP_MEM_LIMIT=1g
# 1.0 = trace every request. Lower it for load tests and record the value in docs/experiment_log.md.
TRACING_SAMPLING_PROBABILITY=1.0
# Hikari maximum pool size per service (4 services x 20 fits the Postgres max_connections=200 budget).
DB_POOL_SIZE=20
# Log level for com.shopsage.* loggers.
LOG_LEVEL=INFO
# Propagate traceparent over Kafka (inventory, order, payment). false = each Saga hop is its own trace.
KAFKA_OBSERVATION_ENABLED=true

# --- Compose profiles ---------------------------------------------------------------------------
# Comma-separated extra profiles to enable by default: app, tools (e.g. COMPOSE_PROFILES=tools).
COMPOSE_PROFILES=
